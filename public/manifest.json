{
    "name": "jRo Tools Plus",
    "description": "jROの公式ページを便利にツール",
    "version": "1.3.5",
    "manifest_version": 3,
    "icons": {
        "16": "images/icon-16.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "homepage_url": "https://chromewebstore.google.com/detail/jro-tools-plus/hgokafkkkicmfmmjnclhmklidgndfkoc?hl=ja&gl=JP",
    "content_scripts": [
        {
            "run_at": "document_end",
            "matches": [
                "https://rotool.gungho.jp/*",
                "https://ragnarokonline.gungho.jp/*"
            ],
            "js": [
                "content_scripts/loader.js"
            ],
            "css": [
                "css/jro_tools_plus.min.css"
            ]
        }
    ],
    "action": {
        "default_icon": "images/icon-19.png",
        "default_title": "jRo Tools Plus を開閉"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "tools/sidepanel.html"
    },
    "permissions": [
        "sidePanel",
        "storage",
        "unlimitedStorage",
        "scripting"
    ],
    "host_permissions": [
        "https://asgrcat.github.io/*",
        "https://rowebtool.gungho.jp/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "css/jro_tools_plus.min.css",
                "tools/js/zeny-characterpage-scraper.js"
            ],
            "matches": [
                "https://rotool.gungho.jp/*",
                "https://rowebtool.gungho.jp/*",
                "https://ragnarokonline.gungho.jp/*"
            ]
        }
    ]
}
