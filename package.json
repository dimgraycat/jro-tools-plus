{
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tailwindcss/cli": "^4.3.1",
    "bootstrap": "^5.3.8",
    "chokidar": "^3.5.3",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^10.1.0",
    "jquery": "^3.7.1",
    "list.js": "^1.5.0",
    "npm-run-all": "^4.1.5",
    "sass-migrator": "^2.6.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.323",
    "@types/jquery": "^3.5.34",
    "@types/mini-css-extract-plugin": "^2.5.0",
    "@types/underscore": "^1.13.0",
    "@types/webpack": "^5.28.5",
    "autoprefixer": "^10.5.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "glob": "^13.0.6",
    "gulp": "^5.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.15",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.1",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run build:prod",
    "build:prod": "npm run clean && npm run build:css:prod && cross-env NODE_ENV=production webpack",
    "build:dev": "npm run clean && npm-run-all -p watch:css watch:js",
    "watch:css": "npx tailwindcss -i ./tools/css/app.css -o ./tools/css/style.css --watch",
    "watch:js": "cross-env NODE_ENV=development webpack --watch",
    "test": "rm -rf .test-build && tsc --project tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "build:css:prod": "tailwindcss -i ./tools/css/app.css -o ./dist/tools/css/style.css --minify",
    "release": "standard-version --release-as",
    "bump": "standard-version --release-as",
    "bump:dryrun": "standard-version --dry-run --release-as"
  },
  "name": "jro-tools-plus",
  "version": "2026.9.1",
  "type": "module",
  "repository": "git@github.com:dimgraycat/jro-tools-plus.git",
  "author": "dimgraycat <dimgray.cat@gmail.com>",
  "license": "MIT"
}
