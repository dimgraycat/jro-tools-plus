{
    "name": "JRO Tools Plus",
    "description": "JROの公式ページを便利にツール",
    "version": "2026.9.1",
    "manifest_version": 3,
    "minimum_chrome_version": "116",
    "icons": {
        "16": "images/icon-16.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "homepage_url": "https://chromewebstore.google.com/detail/jro-tools-plus/hgokafkkkicmfmmjnclhmklidgndfkoc?hl=ja&gl=JP",
    "content_scripts": [
        {
            "run_at": "document_end",
            "matches": [
                "https://rotool.gungho.jp/*"
            ],
            "js": [
                "content_scripts/loader.js"
            ],
            "css": [
                "css/jro_tools_plus.min.css"
            ]
        },
        {
            "run_at": "document_idle",
            "matches": ["https://asgrcat.github.io/jro-search/items/*", "https://asgrcat.github.io/jro-search/monsters/*"],
            "js": ["content_scripts/web-library-bridge.js"]
        }
    ],
    "action": {
        "default_icon": "images/icon-19.png",
        "default_title": "JRO Tools Plus を開閉"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "tools/sidepanel.html"
    },
    "permissions": [
        "sidePanel",
        "scripting",
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://asgrcat.github.io/*",
        "https://rotool.gungho.jp/*",
        "https://rowebtool.gungho.jp/*"
    ]
}
